rule build_master:
    input:
        uniprot="data/interim/uniprot/uniprot_records.parquet",
        rhea="data/interim/rhea/rhea_reactions.parquet",
        go="data/interim/go/go_terms.parquet",
        modomics="data/interim/modomics/modomics_records.parquet",
        ecocyc="data/interim/ecocyc/ecocyc_records.parquet",
        manual="data/interim/manual_literature/manual_literature_records.parquet",
        legacy="data/interim/legacy_pilot/legacy_pilot_records.parquet"
    output:
        master="data/processed/rnmod_master.parquet",
        master_tsv="data/processed/rnmod_master.tsv.gz",
        fasta="data/processed/rnmod_sequences.faa",
        labels="data/processed/rnmod_label_matrix.parquet",
        manifest="data/processed/source_manifest.tsv",
        card="data/processed/rnmod_dataset_card.md"
    conda:
        "envs/ml_rna_mod.yml"
    shell:
        "PYTHONPATH=src python -m rnmod.cli build-master --config configs/config.yaml"

