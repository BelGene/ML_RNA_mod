configfile: "configs/config.yaml"

rule all:
    input:
        "data/processed/rnmod_master.parquet",
        "data/processed/rnmod_master.tsv.gz",
        "data/processed/rnmod_sequences.faa",
        "data/processed/rnmod_label_matrix.parquet",
        "data/processed/source_manifest.tsv",
        "data/processed/rnmod_dataset_card.md"

rule ingest_uniprot:
    output:
        "data/interim/uniprot/uniprot_records.parquet"
    conda:
        "envs/ml_rna_mod.yml"
    shell:
        "PYTHONPATH=src python -m rnmod.cli ingest-uniprot --config configs/config.yaml --output {output}"

rule ingest_rhea:
    output:
        "data/interim/rhea/rhea_reactions.parquet"
    conda:
